#!/usr/bin/env bash
# neofetch_slim: thin wrapper around neofetch with a slim distro logo policy.
# Reference project: https://github.com/dylanaraps/neofetch
# Copyright and license are inherited from the original neofetch project.

set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
base_neofetch="${script_dir}/neofetch"

if [[ ! -x "$base_neofetch" ]]; then
    printf '%s\n' "neofetch_slim: base script not found or not executable: $base_neofetch" >&2
    exit 1
fi

for arg in "$@"; do
    case "$arg" in
        --ascii_distro|--ascii_distro=*|--source|--source=*|--ascii|--ascii=*)
            exec "$base_neofetch" "$@"
        ;;
    esac
done

is_proxmox() {
    command -v pveversion >/dev/null 2>&1 || [[ -d /etc/pve || -f /etc/pve/.version ]]
}

detect_family() {
    local id="" id_like="" name=""

    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        id=${ID:-}
        id_like=${ID_LIKE:-}
        name=${NAME:-}
    fi

    local probe="${id} ${id_like} ${name}"
    probe=${probe,,}

    case "$probe" in
        *kali*) echo "Kali" ;;
        *parrot*) echo "Parrot" ;;
        *alpine*) echo "Alpine" ;;
        *debian*) echo "Debian" ;;
        *) echo "other" ;;
    esac
}

proxmox_ascii_file() {
    local file
    file=$(mktemp "${TMPDIR:-/tmp}/neofetch-slim-proxmox.XXXXXX")
    cat > "$file" <<'EOF'
${c2}
${c2}             .-------------------.   .-------------------.
${c2}            /###################\ /###################\
${c2}           /##################### X #####################\
${c2}          /#####################/ \#####################\
${c2}         /#####################/   \#####################\
${c2}        /#####################/     \#####################\
${c2}        \#####################\     /#####################/
${c2}         \#####################\   /#####################/
${c2}          \#####################\ /#####################/
${c2}           \##################### X ####################/
${c2}            \###################/ \###################/
${c2}             '-------------------'   '-------------------'
EOF
    printf '%s\n' "$file"
}

penguin_ascii_file() {
    local file
    file=$(mktemp "${TMPDIR:-/tmp}/neofetch-slim-penguin.XXXXXX")
    cat > "$file" <<'EOF'
${c1}   .--.
${c1}  |${c2}o_o${c1} |
${c1}  |:_/ |
${c1} //   \\
${c1}(|     | )
${c1}/'\_   _/`\\
${c1}\___)=(___/
${c2}   GNU/Linux
EOF
    printf '%s\n' "$file"
}

cleanup_files=()
cleanup() {
    local f
    for f in "${cleanup_files[@]:-}"; do
        [[ -n "$f" && -f "$f" ]] && rm -f "$f"
    done
}
trap cleanup EXIT

if is_proxmox; then
    ascii_file=$(proxmox_ascii_file)
    cleanup_files+=("$ascii_file")
    exec "$base_neofetch" --source "$ascii_file" --ascii_colors 7 208 "$@"
fi

case "$(detect_family)" in
    Kali|Debian|Parrot|Alpine)
        exec "$base_neofetch" --ascii_distro "$(detect_family)" "$@"
    ;;
    *)
        ascii_file=$(penguin_ascii_file)
        cleanup_files+=("$ascii_file")
        exec "$base_neofetch" --source "$ascii_file" --ascii_colors 7 3 "$@"
    ;;
esac
